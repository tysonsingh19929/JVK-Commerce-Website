# ================================================================
# AESAS (Autonomous E-Commerce Specialist Automation System)
# Environment Configuration & API Keys
# ================================================================

# --- LLM Engines Configuration ---
# Options for HERMES_PROVIDER: 'ollama', 'vllm', 'openrouter', 'together', 'mock'
HERMES_PROVIDER=mock
HERMES_MODEL=hermes3:8b
HERMES_API_BASE=http://localhost:11434/v1
HERMES_API_KEY=

# Options for FRONTIER_PROVIDER: 'anthropic', 'openai', 'openrouter', 'mock'
FRONTIER_PROVIDER=mock
FRONTIER_MODEL=claude-3-7-sonnet-20250219
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Options for QUANT_PROVIDER: 'deepseek', 'openai', 'openrouter', 'mock'
QUANT_PROVIDER=mock
QUANT_MODEL=deepseek-reasoner
DEEPSEEK_API_KEY=

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# --- Amazon Selling Partner API (SP-API) ---
SP_API_USE_MOCK=true
SP_API_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxxxx
SP_API_CLIENT_SECRET=amzn1.oa2-cs.v1.xxxxxxxxxxxx
SP_API_REFRESH_TOKEN=Atzr|xxxxxxxxxxxx
SP_API_AWS_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
SP_API_AWS_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
SP_API_ROLE_ARN=arn:aws:iam::123456789012:role/SPAPIRole

# --- Amazon Advertising API v3 ---
ADS_USE_MOCK=true
ADS_CLIENT_ID=amzn1.application-oa2-client.yyyyyyyyyyyy
ADS_CLIENT_SECRET=amzn1.oa2-cs.v1.yyyyyyyyyyyy
ADS_REFRESH_TOKEN=Atzr|yyyyyyyyyyyy
ADS_PROFILE_ID=1234567890123456

# --- Keepa API ---
KEEPA_USE_MOCK=true
KEEPA_API_KEY=your_keepa_api_key_here

# --- System Defaults ---
DEFAULT_MARKETPLACE=US
OUTPUT_DIR=automation/data
