# JVK Commerce Backend Configuration
PORT=8080
NODE_ENV=development

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=JVKAdmin2026!
JWT_SECRET=jvk_commerce_jwt_secret_key_2026_enterprise_growth

# -----------------------------------------------------------------------------
# Database Connection (Priority order: 1. MongoDB, 2. PostgreSQL, 3. Disk Store)
# -----------------------------------------------------------------------------
# Option 1: MongoDB Atlas (Recommended for document flexibility & cloud backups)
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_NAME=jvk_commerce

# Option 2: Render Managed PostgreSQL
# DATABASE_URL=postgres://user:password@hostname:5432/jvk_commerce

# Option 3: If neither MONGODB_URI nor DATABASE_URL is set,
# the backend automatically stores data safely in local atomic JSON disk store (data/jvk_store.json)
